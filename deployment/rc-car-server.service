[Unit]
Description=RC Car WebSocket control server (styrservo + ESC)
After=network-online.target pigpiod.service
Wants=network-online.target pigpiod.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__/deployment
ExecStart=/usr/bin/python3 __APP_DIR__/deployment/rc-car-server.py
Environment=RC_PORT=81
Environment=RC_STEERING_GPIO=18
Environment=RC_ESC_GPIO=13
Environment=RC_WATCHDOG_TIMEOUT=0.5
Environment=RC_WIFI_IF=wlan0
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
SupplementaryGroups=gpio

[Install]
WantedBy=multi-user.target
