[Unit]
Description=RC Car WebSocket to STM32 UART bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__/deployment
ExecStart=/usr/bin/python3 __APP_DIR__/deployment/rc-car-server.py
Environment=RC_PORT=81
Environment=RC_STM32_UART_PORT=/dev/serial0
Environment=RC_STM32_UART_BAUD=115200
Environment=RC_STM32_HEARTBEAT_INTERVAL=1.0
Environment=RC_SHUTDOWN_ON_STM32_REQUEST=1
Environment="RC_SHUTDOWN_COMMAND=/usr/bin/sudo -n /usr/bin/systemctl poweroff"
Environment=RC_WATCHDOG_TIMEOUT=0.5
Environment=RC_WIFI_IF=wlan0
# Delad hemlighet – sätt samma värde i appens Inställningar > Åtkomsttoken.
# Tomt värde = ingen autentisering (endast för test på ett stängt nät).
Environment=RC_TOKEN=

Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
SupplementaryGroups=dialout
# Port 81 är en privilegierad port (<1024) – tillåt bindning utan att köra som root.
# gpio-poweroff-overlayen ska vara konfigurerad med gpiopin=26 så STM32 får
# RPI_POWER_OFF_OK innan REG_5V_EN bryts.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID


[Install]
WantedBy=multi-user.target
