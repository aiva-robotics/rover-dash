[Unit]
Description=Raspberry Pi Camera MJPEG stream (RC Control)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
ExecStart=/usr/bin/python3 __APP_DIR__/deployment/pi-camera-server.py
Environment=CAM_PORT=8080
Environment=CAM_WIDTH=640
Environment=CAM_HEIGHT=480
Environment=CAM_FPS=20
Environment=CAM_QUALITY=75
Environment=CAM_HFLIP=0
Environment=CAM_VFLIP=0
Restart=always
RestartSec=3
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
